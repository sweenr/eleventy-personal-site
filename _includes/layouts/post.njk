---
layout: layouts/base.njk
section: post
---

<article class="post-page">
  <h1>{{ title }}</h1>
  <p class="post-meta">
    <time datetime="{{ page.date | machineDate }}">{{ page.date | readableDate }}</time> by {{ author }}
  </p>

  {% if tags %}
    <div class="post-tags">
    {% for tag in tags %}
      {%- if tag != "post" -%}
        {% set tagUrl %}/tags/{{ tag }}/{% endset %}
        <a href="{{ tagUrl | url }}" rel="tag">{{ tag }}</a>
      {%- endif -%}
    {% endfor %}
    </div>
  {% endif %}

  {% if featuredImageUrl %}
    <img src="{{ featuredImageUrl }}" alt="{{ featuredImageAlt }}" class="post-hero-img" loading="lazy">
  {% endif %}

  {{ content | safe }}

</article>

<nav>
  <a href="{{ '/blog/' | url }}">← Blog index</a>
</nav>
