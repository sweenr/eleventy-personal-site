<section class="posts-grid">
	{% for post in postslist | reverse %}
		{% if post.data.draft !== true %}
		<a href="{{ post.url | url }}" class="post-card"{% if post.url == url %} data-current="current item"{% endif %}>
			{% if post.data.featuredImageUrl %}
				<img src="{{ post.data.featuredImageUrl }}" alt="{{ post.data.featuredImageAlt }}" class="post-card-img" loading="lazy">
			{% endif %}
			<div class="post-card-body">
				<h3>
					{% if post.data.title %}
						{{ post.data.title }}
					{% else %}
						Untitled
					{% endif %}
				</h3>
				{% if post.data.description %}
					<p class="post-card-desc">{{ post.data.description }}</p>
				{% endif %}
				<div class="post-card-meta">
					<time datetime="{{ post.date | machineDate }}">{{ post.date | readableDate }}</time>
					{% if post.data.tags %}
						<div class="post-card-tags">
							{% for tag in post.data.tags %}
								{%- if tag != "post" -%}
									<span class="tag">{{ tag }}</span>
								{%- endif -%}
							{% endfor %}
						</div>
					{% endif %}
				</div>
			</div>
		</a>
		{% endif %}
	{% endfor %}
</section>
